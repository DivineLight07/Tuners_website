  <script src="/js/about_us.js"></script>
  
  <script>
    // Load board members from database
    async function loadBoardMembers() {
      const container = document.getElementById('boardMembersContainer');
      if (!container) return;

      try {
        const response = await fetch('/api/v1/board');
        const data = await response.json();
        
        if (!response.ok || !data.success) {
          throw new Error('Failed to load board members');
        }

        const members = data.data || [];
        
        if (members.length === 0) {
          container.innerHTML = '<p style="text-align: center; color: rgba(255,255,255,0.6); grid-column: 1/-1;">No board members yet.</p>';
          return;
        }

        container.innerHTML = members.map(member => `
          <div class="member-card">
            <img src="${member.image}" alt="${member.name}" onerror="this.onerror=null;this.src='/images/Default-pfp.png';" class="member-photo">
            <h3>${member.name}</h3>
            <p class="position">${member.position}</p>
            ${member.bio ? `<p class="bio">${member.bio}</p>` : ''}
            ${member.socialMedia && (member.socialMedia.instagram || member.socialMedia.facebook || member.socialMedia.linkedin) ? `
              <div class="social-links">
                ${member.socialMedia.instagram ? `<a href="${member.socialMedia.instagram}" target="_blank" class="social-icon">📸</a>` : ''}
                ${member.socialMedia.facebook ? `<a href="${member.socialMedia.facebook}" target="_blank" class="social-icon">📘</a>` : ''}
                ${member.socialMedia.linkedin ? `<a href="${member.socialMedia.linkedin}" target="_blank" class="social-icon">💼</a>` : ''}
              </div>
            ` : ''}
          </div>
        `).join('');
        
      } catch (err) {
        console.error('Error loading board members:', err);
        container.innerHTML = '<p style="text-align: center; color: rgba(255,255,255,0.6);">Failed to load board members.</p>';
      }
    }

    // Load on page load
    document.addEventListener('DOMContentLoaded', loadBoardMembers);
  </script>
</body>
</html>