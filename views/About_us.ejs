<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "About Us - Tuners MIU" }) %>
</head>
<body>

  <%- include("partials/navbar") %>

  <!-- CONTENT -->
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="relative py-20 lg:py-32 overflow-hidden">
      <!-- Glow effects -->
      <div class="absolute inset-0 bg-gradient-to-b from-primary/10 to-transparent pointer-events-none"></div>
      <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-primary/20 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div data-aos="fade-up" data-aos-delay="0">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/20 text-white text-sm font-medium mb-6 backdrop-blur-sm border border-primary/30">
            <i data-lucide="music-2" class="w-3.5 h-3.5"></i>
            About Us
          </div>
          
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold font-display mb-8 leading-tight tracking-wide">
            Tuners Club<br />
            <span class="text-primary">Misr International University</span>
          </h1>
          
          <p class="text-lg text-white/80 max-w-3xl mx-auto leading-relaxed">
            At Tuners Club – MIU, we believe music is more than sound; it's a language that unites people, sparks creativity, and builds community. Founded by passionate students, Tuners Club is MIU's home for musicians, singers, and music lovers who want to share their talents, discover new rhythms, and create unforgettable experiences on campus.
          </p>
        </div>
      </div>
    </section>

    <!-- Mission & Vision -->
    <section class="py-20 bg-black/20 backdrop-blur-sm border-y border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-10">
          <!-- Mission -->
          <div data-aos="fade-right" data-aos-delay="100" class="bg-card backdrop-blur-md rounded-[2rem] border border-border/50 p-10 shadow-xl hover:shadow-primary/10 transition-shadow">
            <div class="w-14 h-14 rounded-2xl bg-primary/20 flex items-center justify-center mb-6">
              <i data-lucide="target" class="w-7 h-7 text-white"></i>
            </div>
            <h2 class="text-3xl font-bold font-display tracking-wide mb-4">Our Mission 🎶</h2>
            <p class="text-white/70 leading-relaxed text-lg">
              We aim to inspire and empower students through music. Whether you're a seasoned performer or just beginning your journey, Tuners Club provides a supportive space to explore your passion, collaborate with peers, and bring harmony to student life.
            </p>
          </div>

          <!-- Vision -->
          <div data-aos="fade-left" data-aos-delay="200" class="bg-card backdrop-blur-md rounded-[2rem] border border-border/50 p-10 shadow-xl hover:shadow-primary/10 transition-shadow">
            <div class="w-14 h-14 rounded-2xl bg-primary/20 flex items-center justify-center mb-6">
              <i data-lucide="star" class="w-7 h-7 text-white"></i>
            </div>
            <h2 class="text-3xl font-bold font-display tracking-wide mb-4">Our Vision 🌟</h2>
            <p class="text-white/70 leading-relaxed text-lg">
              Tuners Club strives to be more than just a student organization, we envision a vibrant community where music is celebrated as a universal language, enriching campus life and leaving a lasting impact on everyone who joins.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What We Do -->
    <section class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 data-aos="fade-up" class="text-4xl font-bold font-display tracking-wide">What We Do 🎤</h2>
          <p data-aos="fade-up" data-aos-delay="100" class="mt-4 text-white/70 max-w-lg mx-auto text-lg">
            From the music room to the main stage, here's how we bring music to campus life.
          </p>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
          <!-- Card 1 -->
          <div data-aos="fade-up" data-aos-delay="100" class="group bg-card backdrop-blur-md rounded-2xl border border-border/50 p-6 hover:shadow-xl hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center mb-5 group-hover:bg-primary transition-colors">
              <i data-lucide="mic-2" class="w-6 h-6 text-white"></i>
            </div>
            <h3 class="font-semibold text-xl mb-3">Live Performances</h3>
            <p class="text-sm text-white/70 leading-relaxed">Taking the stage at concerts, open mic nights, and campus events to share our sound with MIU.</p>
          </div>

          <!-- Card 2 -->
          <div data-aos="fade-up" data-aos-delay="200" class="group bg-card backdrop-blur-md rounded-2xl border border-border/50 p-6 hover:shadow-xl hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center mb-5 group-hover:bg-primary transition-colors">
              <i data-lucide="guitar" class="w-6 h-6 text-white"></i>
            </div>
            <h3 class="font-semibold text-xl mb-3">Jamming Sessions</h3>
            <p class="text-sm text-white/70 leading-relaxed">Relaxed gatherings where students come together to play, improvise, and enjoy music collectively.</p>
          </div>

          <!-- Card 3 -->
          <div data-aos="fade-up" data-aos-delay="300" class="group bg-card backdrop-blur-md rounded-2xl border border-border/50 p-6 hover:shadow-xl hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center mb-5 group-hover:bg-primary transition-colors">
              <i data-lucide="door-open" class="w-6 h-6 text-white"></i>
            </div>
            <h3 class="font-semibold text-xl mb-3">Music Room</h3>
            <p class="text-sm text-white/70 leading-relaxed">A fully equipped space on campus where members can practice, experiment, and enjoy playing together.</p>
          </div>

          <!-- Card 4 -->
          <div data-aos="fade-up" data-aos-delay="400" class="group bg-card backdrop-blur-md rounded-2xl border border-border/50 p-6 hover:shadow-xl hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center mb-5 group-hover:bg-primary transition-colors">
              <i data-lucide="book-open" class="w-6 h-6 text-white"></i>
            </div>
            <h3 class="font-semibold text-xl mb-3">Courses & Workshops</h3>
            <p class="text-sm text-white/70 leading-relaxed">Structured sessions teaching instruments, vocals, and music theory, guided by experienced members and instructors.</p>
          </div>

          <!-- Card 5 -->
          <div data-aos="fade-up" data-aos-delay="500" class="group bg-card backdrop-blur-md rounded-2xl border border-border/50 p-6 hover:shadow-xl hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center mb-5 group-hover:bg-primary transition-colors">
              <i data-lucide="users" class="w-6 h-6 text-white"></i>
            </div>
            <h3 class="font-semibold text-xl mb-3">Community Building</h3>
            <p class="text-sm text-white/70 leading-relaxed">Creating a welcoming environment where students connect through their shared love of music.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Meet the Board -->
    <section class="py-24 bg-black/20 backdrop-blur-sm border-t border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 relative">
          <h2 data-aos="fade-up" class="text-4xl font-bold font-display tracking-wide">Meet the Board 👥</h2>
          <p data-aos="fade-up" data-aos-delay="100" class="mt-4 text-white/70 text-lg">The people who make Tuners happen.</p>
          <div class="admin-only mt-6 flex justify-center">
            <button onclick="openAddBoardMemberModal()" class="btn-primary flex items-center gap-2">
              <i data-lucide="plus" class="w-4 h-4"></i> Add Board Member
            </button>
          </div>
        </div>
        
        <div id="publicBoardMembersList" class="flex flex-wrap justify-center gap-6">
          <p class="text-white/60">Loading board members...</p>
        </div>
      </div>
    </section>
  </main>

  <%- include("partials/footer") %>

  <!-- Board Member Modal for Admin Edit -->
  <div id="boardMemberModal" class="modal-overlay" style="display:none">
    <div class="modal-content text-left">
      <span onclick="closeBoardMemberModal()" class="modal-close">&times;</span>
      <h2 id="boardModalTitle" class="text-3xl font-display font-bold mb-6 text-white">Edit Board Member</h2>
      <form id="boardMemberForm" onsubmit="saveBoardMember(event)" class="space-y-4 text-left">
        <input type="hidden" id="board-member-id">
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="form-label">Name *</label><input type="text" id="board-member-name" required class="form-input"></div>
          <div><label class="form-label">Position *</label><input type="text" id="board-member-position" required class="form-input"></div>
        </div>
        <div><label class="form-label">Image URL</label><input type="text" id="board-member-image" placeholder="/images/Default-pfp.png" class="form-input"></div>
        <div>
          <label class="form-label">Display Order</label>
          <input type="number" id="board-member-order" value="0" min="0" class="form-input">
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t border-white/10 mt-4">
          <button type="button" onclick="closeBoardMemberModal()" class="px-6 py-2 border border-white/20 text-white rounded-lg font-medium hover:bg-white/5 transition-colors">Cancel</button>
          <button type="submit" class="btn-primary px-8">Save</button>
        </div>
      </form>
    </div>
  </div>
  
  <div id="Msg"></div>

  <%- include("partials/scripts") %>
  <script src="/js/about_us.js"></script>
</body>
</html>
