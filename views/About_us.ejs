    <!-- Mission & Vision -->
    <section class="py-20 bg-black/20 backdrop-blur-sm border-y border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-10">
          <!-- Mission -->
