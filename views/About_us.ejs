            <button onclick="openAddBoardMemberModal()" class="btn-primary flex items-center gap-2">
              <i data-lucide="plus" class="w-4 h-4"></i> Add Board Member
            </button>
          </div>
        </div>
        
        <div id="publicBoardMembersList" class="flex flex-wrap justify-center gap-6">
          <p class="text-white/60">Loading board members...</p>
        </div>
      </div>
    </section>
  </main>

