<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tuners MIU - Member Dashboard</title>
  
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: { DEFAULT: '#1f6feb', foreground: '#ffffff' },
            accent: '#133785',
            background: 'rgba(10, 26, 62, 0.65)',
            card: { DEFAULT: 'rgba(10, 26, 62, 0.45)', foreground: '#ffffff' },
            destructive: { DEFAULT: '#ff6b6b', foreground: '#ffffff' },
            muted: { DEFAULT: 'rgba(255,255,255,0.1)', foreground: 'rgba(255,255,255,0.6)' },
            border: 'rgba(255,255,255,0.18)',
            input: 'rgba(255,255,255,0.1)',
          },
          fontFamily: {
            display: ['"Bebas Neue"', 'sans-serif'],
            sans: ['Poppins', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style type="text/tailwindcss">
    @layer base {
      body {
        @apply font-sans text-white bg-cover bg-center bg-fixed min-h-screen relative flex flex-col;
        background-image: url('/images/IMG_4362.png');
      }
      body::after {
        content: '';
        @apply fixed inset-0 bg-background -z-10;
      }
    }
    @layer components {
      .card-container {
        @apply bg-card backdrop-blur-md rounded-2xl border border-border/50 p-6 shadow-xl;
      }
      .card-header {
        @apply flex items-center gap-2 mb-4 pb-4 border-b border-white/10;
      }
      .card-title {
        @apply text-xl font-bold font-display tracking-wide;
      }
      
      /* Mapping old JS classes to Tailwind */
      .badges-container {
        @apply flex flex-wrap gap-2 mt-2;
      }
      .badge-pill {
        @apply inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[13px] font-semibold bg-gradient-to-r from-primary/30 to-primary/10 text-white border border-primary/40 shadow-[0_0_10px_rgba(31,111,235,0.15)] transition-transform hover:-translate-y-0.5 cursor-default;
      }
      .status-available {
        @apply text-green-400 font-medium bg-green-400/10 px-2 py-0.5 rounded text-sm;
      }
      .status-occupied {
        @apply text-red-400 font-medium bg-red-400/10 px-2 py-0.5 rounded text-sm;
      }
      .request-card {
        @apply p-4 rounded-xl bg-black/20 border border-white/10 mt-4 text-sm;
      }
      .request-time {
        @apply text-white/60 mt-1 text-xs;
      }
      #coursesList div {
        @apply p-3 mb-2 rounded-lg bg-black/20 border border-white/10 text-sm;
      }
      #profileData p {
        @apply mb-2 text-white/80;
      }
    }
    .lucide { width: 1em; height: 1em; }
    .hidden { display: none !important; }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav id="navbar" class="w-full bg-[#133785]/85 backdrop-blur-md border-b border-white/15 grid grid-cols-[auto_1fr_auto] items-center px-8 py-2.5 sticky top-0 z-[100] transition-transform duration-300">
    <a href="/home"><img src="/images/Tuners-Logo.png" alt="Tuners Logo" id="nav-logo" class="h-12 w-auto drop-shadow-md"/></a>
    <ul class="flex gap-10 justify-center">
      <li><a href="/home" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">Home</a></li>
      <li><a href="/about" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">About Us</a></li>
      <li><a href="/apply" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">Apply</a></li>
      <li><a href="#site-footer" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">Contact</a></li>
      <li><a href="/courses" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">Courses</a></li>
      <li><a href="/gallery" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">Gallery</a></li>
      <li id="nav-dashboard" style="display:none;"><a href="#" id="nav-dashboard-link" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors text-primary font-bold">Dashboard</a></li>
    </ul>
    <div class="flex gap-4 items-center">
        <a href="/login" id="nav-login-btn" class="px-4 py-2 bg-white/10 hover:bg-white/20 hover:-translate-y-[1px] border border-white/20 rounded-lg text-[0.9rem] font-semibold transition-all">Login</a>
        <button id="nav-logout-btn" style="display:none;" onclick="globalLogout()" class="px-4 py-2 bg-white/10 hover:bg-white/20 hover:-translate-y-[1px] border border-white/20 rounded-lg text-[0.9rem] font-semibold transition-all text-destructive border-destructive/50 hover:bg-destructive/20">Logout</button>
    </div>
  </nav>

  <!-- CONTENT -->
  <main class="flex-1 py-10 lg:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4" data-aos="fade-up">
        <div>
          <h1 id="welcomeTitle" class="text-4xl sm:text-5xl font-bold font-display tracking-wide">Welcome back!</h1>
          <p class="text-white/70 mt-2">Your member dashboard</p>
        </div>
        
        <!-- Small Room Status Box -->
        <div class="bg-card backdrop-blur-md rounded-xl border border-border/50 px-5 py-3 shadow-lg flex items-center gap-3">
          <i data-lucide="door-open" class="w-4 h-4 text-white/70"></i>
          <span class="text-sm font-semibold tracking-wide uppercase text-white/80">Room Status:</span>
          <span id="currentRoomStatus" class="status-available">Open</span>
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-8">
        
        <!-- Profile Summary -->
        <div class="card-container flex flex-col" data-aos="fade-up" data-aos-delay="100">
          <div class="card-header">
            <i data-lucide="user" class="w-5 h-5"></i>
            <h2 class="card-title">My Profile</h2>
          </div>
          <div id="profileData" class="flex-1"></div>
          
          <button id="editProfileBtn" onclick="openEditProfile()" class="w-full mt-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-medium transition-all">
            Edit Profile
          </button>
        </div>



        <!-- My Courses -->
        <div class="card-container flex flex-col" data-aos="fade-up" data-aos-delay="300">
          <div class="card-header">
            <i data-lucide="book-open" class="w-5 h-5"></i>
            <h2 class="card-title">My Courses</h2>
          </div>
          <div id="coursesList" class="flex-1 overflow-y-auto max-h-[400px]"></div>
        </div>

      </div>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="w-full bg-[#0a1a3e]/65 backdrop-blur-md border-t border-white/15 py-10 mt-auto relative overflow-hidden" id="site-footer">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-[100px] bg-primary/10 blur-[80px] pointer-events-none"></div>
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 px-8 relative z-10">
      <div class="flex flex-col">
        <h3 class="text-xl font-display font-bold mb-4 tracking-wider flex items-center gap-2"><i data-lucide="music"></i> Tuners MIU</h3>
        <p class="text-white/60 text-sm mb-4 leading-relaxed">The official music club of Misr International University. Bringing harmony to campus life.</p>
        <div class="mt-auto">
          <h4 class="text-sm font-semibold mb-2 text-white/80">Contact Us</h4>
          <a href="mailto:tuners.miu.eg@gmail.com" class="inline-flex items-center gap-2 text-primary-400 hover:text-white transition-colors text-sm font-medium"><i data-lucide="mail" class="w-4 h-4"></i> tuners.miu.eg@gmail.com</a>
        </div>
      </div>
      <div>
        <h3 class="text-xl font-display font-bold mb-4 tracking-wider">Follow Us</h3>
        <ul class="space-y-3">
          <li><a href="https://www.instagram.com/tunersclubmiu" target="_blank" class="inline-flex items-center gap-2.5 px-3 py-2.5 rounded-lg bg-white/5 hover:bg-white/15 hover:text-white transition-colors text-white/80 w-full sm:w-auto"><img src="/images/Instagram.png" class="w-4 h-4 object-contain" alt="Instagram"> Instagram</a></li>
          <li><a href="https://www.facebook.com/TunersClubMIU" target="_blank" class="inline-flex items-center gap-2.5 px-3 py-2.5 rounded-lg bg-white/5 hover:bg-white/15 hover:text-white transition-colors text-white/80 w-full sm:w-auto"><img src="/images/Facebook.png" class="w-4 h-4 object-contain" alt="Facebook"> Facebook</a></li>
          <li><a href="https://www.tiktok.com/@tunersmusic" target="_blank" class="inline-flex items-center gap-2.5 px-3 py-2.5 rounded-lg bg-white/5 hover:bg-white/15 hover:text-white transition-colors text-white/80 w-full sm:w-auto"><img src="/images/Tiktok.png" class="w-4 h-4 object-contain" alt="TikTok"> TikTok</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-xl font-display font-bold mb-4 tracking-wider">Quick Links</h3>
        <div class="grid grid-cols-2 gap-2">
          <a href="/home" class="px-3 py-2 rounded-lg bg-white/5 hover:bg-white/15 transition-colors text-white/80 hover:text-white text-sm text-center">Home</a>
          <a href="/about" class="px-3 py-2 rounded-lg bg-white/5 hover:bg-white/15 transition-colors text-white/80 hover:text-white text-sm text-center">About Us</a>
          <a href="/courses" class="px-3 py-2 rounded-lg bg-white/5 hover:bg-white/15 transition-colors text-white/80 hover:text-white text-sm text-center">Courses</a>
          <a href="/gallery" class="px-3 py-2 rounded-lg bg-white/5 hover:bg-white/15 transition-colors text-white/80 hover:text-white text-sm text-center">Gallery</a>
          <a href="/apply" class="px-3 py-2 rounded-lg bg-white/5 hover:bg-white/15 transition-colors text-white/80 hover:text-white text-sm text-center">Apply</a>
        </div>
      </div>
    </div>
    <div class="max-w-6xl mx-auto px-8 mt-10 pt-6 border-t border-white/10 text-center">
      <p class="text-white/40 text-xs">© 2026 Tuners Club MIU. All rights reserved.</p>
    </div>
  </footer>

  <!-- MODALS -->
  <div id="editProfileModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[200] hidden items-center justify-center p-4">
    <div class="bg-[#0a1a3e] border border-white/10 rounded-2xl w-full max-w-md p-6 relative shadow-2xl">
      <span onclick="closeEditProfile()" class="absolute top-4 right-4 text-white/50 hover:text-white cursor-pointer text-2xl leading-none">&times;</span>
      <h2 class="text-2xl font-bold font-display tracking-wider mb-6">Edit Profile</h2>
      <form id="editProfileForm" onsubmit="saveProfile(event)" class="space-y-4">
        <div class="space-y-1">
          <label for="edit-name" class="text-xs text-white/70 uppercase tracking-widest">Name</label>
          <input type="text" id="edit-name" required class="w-full h-10 px-3 bg-input border border-border rounded-lg text-sm focus:outline-none focus:border-primary transition-all">
        </div>
        <div class="space-y-1">
          <label for="edit-email" class="text-xs text-white/70 uppercase tracking-widest">Email</label>
          <input type="email" id="edit-email" required class="w-full h-10 px-3 bg-input border border-border rounded-lg text-sm focus:outline-none focus:border-primary transition-all">
        </div>
        <div class="space-y-1">
          <label for="edit-uid" class="text-xs text-white/70 uppercase tracking-widest">University ID</label>
          <input type="text" id="edit-uid" required class="w-full h-10 px-3 bg-input border border-border rounded-lg text-sm focus:outline-none focus:border-primary transition-all">
        </div>
        <div class="space-y-1">
          <label for="edit-old-pass" class="text-xs text-white/70 uppercase tracking-widest">Old Password</label>
          <input type="password" id="edit-old-pass" required class="w-full h-10 px-3 bg-input border border-border rounded-lg text-sm focus:outline-none focus:border-primary transition-all">
        </div>
        <div class="space-y-1">
          <label for="edit-pass" class="text-xs text-white/70 uppercase tracking-widest">New Password</label>
          <div class="flex gap-2">
            <input type="password" id="edit-pass" required class="w-full h-10 px-3 bg-input border border-border rounded-lg text-sm focus:outline-none focus:border-primary transition-all">
            <button type="button" id="toggle-pass-btn" onclick="togglePasswordVisibility()" class="px-3 bg-white/10 rounded-lg text-xs font-medium hover:bg-white/20 transition-all">Show</button>
          </div>
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t border-white/10 mt-6">
          <button type="button" onclick="closeEditProfile()" class="px-6 py-2 border border-white/20 rounded-lg font-medium hover:bg-white/5 transition-colors">Cancel</button>
          <button type="submit" class="px-6 py-2 bg-primary text-white rounded-lg font-medium hover:bg-[#1a48a8] transition-colors">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  
  <script>
    lucide.createIcons();
    AOS.init({ duration: 600, once: true });
    
    const originalOpenEditProfile = window.openEditProfile;
    window.openEditProfile = function() {
        if(originalOpenEditProfile) originalOpenEditProfile();
        const el = document.getElementById('editProfileModal');
        if(el) {
            el.classList.remove('hidden');
            el.style.display = 'flex';
        }
    };
    
    const originalCloseEditProfile = window.closeEditProfile;
    window.closeEditProfile = function() {
        if(originalCloseEditProfile) originalCloseEditProfile();
        const el = document.getElementById('editProfileModal');
        if(el) {
            el.classList.add('hidden');
            el.style.display = 'none';
        }
    };
  </script>
  
  <script src="/js/member_dashboard.js"></script>
  
</body>
</html>
