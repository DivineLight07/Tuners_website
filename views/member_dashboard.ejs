        <div class="welcome_msg">
            <h1 id="welcomeTitle">Welcome back!</h1>
        </div>

        <div id="courses" class="my_courses">
            <h2>My Music Theory Courses</h2>
            <div id="coursesList"></div>
        </div>

        <div id="roomBooking" class="my_room_bookings">
            <h2>Room Booking</h2>
            
            <div class="room-status-indicator">
                <strong>Current Room Status:</strong> <span id="currentRoomStatus" class="status-available">Open</span>
            </div>
            
            <div id="bookingsList" class="bookings-list">
            </div>
            
            <button type="button" id="requestRoomBtn">Request Room Now</button>
        </div>

        <div id="profile" class="profile_summary">
            <h2>My Profile Summary</h2>
            <div id="profileData"></div>
            <button id="editProfileBtn" onclick="openEditProfile()" class="btn-primary" style="margin-top: 15px;">Edit Profile</button>
            
            <div id="inlineEditProfile" style="display:none; margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 20px;">
                <h3 style="margin-top: 0;">Edit Profile</h3>
                <form id="editProfileForm" onsubmit="saveProfile(event)">
                    <div class="form-group">
                        <label for="edit-name">Name</label>
                        <input type="text" id="edit-name" required>
                    </div>
                    <div class="form-group">
                        <label for="edit-email">Email</label>
                        <input type="email" id="edit-email" required>
                    </div>
                    <div class="form-group">
                        <label for="edit-old-pass">Old Password (Required)</label>
                        <input type="password" id="edit-old-pass" required>
                    </div>
                    <div class="form-group">
                        <label for="edit-pass">New Password</label>
                        <div style="display: grid; grid-template-columns: 1fr auto; gap: 10px;">
                            <input type="password" id="edit-pass" required>
                            <button type="button" id="toggle-pass-btn" onclick="togglePasswordVisibility()" class="btn-primary" style="margin-top:0; padding: 0 15px; font-size: 0.9rem;">Show</button>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="edit-uid">University ID</label>
                        <input type="text" id="edit-uid" required>
                    </div>
                    <div style="display:flex; gap:10px; margin-top: 10px;">
                        <button type="submit" class="btn-primary">Save Changes</button>
                        <button type="button" onclick="closeEditProfile()" class="btn-primary" style="background: rgba(255,255,255,0.2);">Cancel</button>
                    </div>
                </form>
            </div>
        </div>


