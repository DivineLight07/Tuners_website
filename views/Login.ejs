  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/Login.css"/>
</head>
<body style="background-image: url('/images/IMG_4362.png'); background-size: cover; background-repeat: no-repeat; background-attachment: fixed;">

  <nav id="navbar">
    <a href="/home"><img src="/images/Tuners-Logo.png" alt="Tuners Logo" id="nav-logo"/></a>
    <ul>
      <li><a href="/home">Home</a></li>
      <li><a href="/about">About Us</a></li>
      <li><a href="/apply">Apply</a></li>
      <li><a href="#site-footer">Contact</a></li>
      <li><a href="/courses">Courses</a></li>
      <li id="nav-dashboard" style="display:none;"><a href="#" id="nav-dashboard-link">Dashboard</a></li>
    </ul>
    <div class="nav-auth">
        <a href="/login" id="nav-login-btn">Login</a>
        <button id="nav-logout-btn" style="display:none;" onclick="globalLogout()">Logout</button>
    </div>
  </nav>

  
  <div class="pages-wrap">

    <div id="page-login" class="page active">
      <div class="card">
        <h2>Welcome Back</h2>
        <p>Sign in to your Tuners account</p>

        <label>Email</label>
        <input type="email" id="login-email" placeholder="you@miuegypt.edu.eg"/>
        <span class="err" id="login-email-err">Enter a valid email address.</span>

        <label>Password</label>
        <input type="password" id="login-pass" placeholder="Password"/>
        <span class="err" id="login-pass-err">Password is required.</span>

        <span id="login-wrong-err">Incorrect email or password.</span>

        <button class="btn" onclick="handleLogin()">Login</button>
      </div>
    </div>

   
    <div id="page-admin" class="page">
      <div class="card">
        <span class="badge admin">Admin</span>
        <h2>Admin Dashboard</h2>
        <p>Welcome back, <strong>Administrator</strong>. You have full access.</p>
        <button class="btn outline" onclick="logout()">Logout</button>
      </div>
    </div>

    
    <div id="page-member" class="page">
      <div class="card">
        <span class="badge member">Member</span>
        <h2>Member Area</h2>
        <p>Welcome to <strong>Tuners Club</strong>. Good to have you here.</p>
        <button class="btn outline" onclick="logout()">Logout</button>
      </div>
    </div>

  </div>

  <div id="Msg"></div>

  <footer class="footer" id="site-footer">
    <div class="footer-content">
      <div class="footer-section">
        <h3>Contact Us</h3>
      </div>
