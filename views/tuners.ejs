<!-- ✅ MAIN CONTENT -->
<div class="container">

    <!-- FORM SECTION -->
    <div class="card">
        <h1>MIU Tuners Club Application</h1>
        <p>Fill out the form below to apply for membership.</p>

        <form id="applicationForm">

            <label for="fullname">Full Name:</label><br>
            <input type="text" id="fullname" placeholder="e.g. Ahmed Mohamed"><br><br>

            <label for="student_id">Student ID:</label><br>
            <input type="text" id="student_id" placeholder="e.g. 24/12345"><br><br>

            <label for="year">Year:</label><br>
            <select id="year">
                <option value="">Select your year</option>
                <option value="1st">1st Year</option>
                <option value="2nd">2nd Year</option>
                <option value="3rd">3rd Year</option>
                <option value="4th">4th Year</option>
                <option value="5th">5th Year</option>
                <option value="graduate">Graduate</option>
            </select><br><br>

            <label for="committee">Which committee are you interested in?</label><br>
            <select id="committee">
                <option value="">Select a committee</option>
                <option value="events">Events committee</option>
                <option value="media">Social media committee</option>
                <option value="technical">Technical committee</option>
                <option value="academic">Academic committee</option>
                <option value="musician">Musician committee</option>
            </select><br><br>

            <!-- Musician field -->
            <div id="musician_fields" style="display: none;">
                <label for="instrument">What instrument do you play?</label><br>
                <select id="instrument">
                    <option value="">Select your instrument</option>
                    <option value="Guitar">Guitar</option>
                    <option value="Piano">Piano</option>
                    <option value="Drums">Drums</option>
                    <option value="Violin">Violin</option>
                    <option value="Bass Guitar">Bass Guitar</option>
                    <option value="Keyboard">Keyboard</option>
                    <option value="Vocals">Vocals</option>
                    <option value="Saxophone">Saxophone</option>
                    <option value="Flute">Flute</option>
                    <option value="Other">Other</option>
                </select>
                <div id="other_instrument_container" style="display: none; margin-top: 10px;">
                    <label for="other_instrument">Specify your instrument:</label><br>
                    <input type="text" id="other_instrument" placeholder="e.g. Oud, Cello, etc.">
                </div>
                <br>
            </div>

            <label for="major">Major:</label><br>
            <select id="major">
                <option value="">Select your major</option>
                <option value="Computer Science">Computer Science</option>
                <option value="Computer Engineering">Computer Engineering</option>
                <option value="Al-Alsun">Al-Alsun</option>
                <option value="Visual Communication">Visual Communication</option>
                <option value="Architecture">Architecture</option>
                <option value="Business Administration">Business Administration</option>
                <option value="Dental Medicine">Dental Medicine</option>
                <option value="Electronics">Electronics</option>
                <option value="Pharmacy">Pharmacy</option>
                <option value="Mass Communication">Mass Communication</option>
            </select><br><br>

            <label for="hear_about">How did you hear about the club?</label><br>
            <input type="text" id="hear_about" placeholder="e.g. Instagram, Friend"><br><br>

            <label for="reason">Why do you want to join the club?</label><br>
            <textarea id="reason" rows="4" placeholder="e.g. I want to improve my skills..."></textarea><br><br>

            <label for="email">Email:</label><br>
            <input type="email" id="email" placeholder="e.g. student@miu.edu.eg"><br><br>

            <label for="phone">Phone Number:</label><br>
            <input type="tel" id="phone" placeholder="e.g. 01234567890"><br><br>

            <button type="submit">Submit Application</button>
            <button type="reset">Reset Form</button>

        </form>
    </div>

</div>


