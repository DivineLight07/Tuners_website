<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tuners — Admin Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: { DEFAULT: '#1f6feb', foreground: '#ffffff' },
            accent: '#133785',
            background: 'rgba(10, 26, 62, 0.65)',
            card: { DEFAULT: 'rgba(10, 26, 62, 0.45)', foreground: '#ffffff' },
            destructive: { DEFAULT: '#ff6b6b', foreground: '#ffffff' },
            muted: { DEFAULT: 'rgba(255,255,255,0.1)', foreground: 'rgba(255,255,255,0.6)' },
            border: 'rgba(255,255,255,0.18)',
            input: 'rgba(255,255,255,0.1)',
          },
          fontFamily: {
            display: ['"Bebas Neue"', 'sans-serif'],
            sans: ['Poppins', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style type="text/tailwindcss">
    @layer base {
      body {
        @apply font-sans text-white bg-cover bg-center bg-fixed min-h-screen relative flex flex-col;
        background-image: url('/images/IMG_4362.png');
      }
      body::after {
        content: '';
        @apply fixed inset-0 bg-background -z-10;
      }
    }
    @layer components {
      .admin-card {
        @apply bg-card backdrop-blur-md rounded-2xl border border-border/50 p-6 shadow-xl mb-6;
      }
      .card-title {
        @apply text-2xl font-bold font-display tracking-wide mb-6 pb-4 border-b border-white/10 flex items-center gap-2;
      }
      .btn-primary {
        @apply px-4 py-2 bg-primary hover:bg-[#1a48a8] text-white rounded-lg text-sm font-medium transition-all;
      }
      .btn-delete {
        @apply px-4 py-2 bg-destructive/80 hover:bg-destructive text-white rounded-lg text-sm font-medium transition-all;
      }
      .status-available {
        @apply text-green-400 font-medium bg-green-400/10 px-3 py-1 rounded-full text-sm;
      }
      .status-occupied {
        @apply text-red-400 font-medium bg-red-400/10 px-3 py-1 rounded-full text-sm;
      }
      .modal-overlay {
        @apply fixed inset-0 bg-black/80 z-[10000] items-center justify-center p-4 backdrop-blur-sm hidden;
      }
      .modal-content {
        @apply bg-[#0a1a3e] rounded-2xl p-8 w-full max-w-2xl max-h-[90vh] overflow-y-auto border border-white/10 relative shadow-2xl;
      }
      .modal-close {
        @apply absolute top-6 right-6 text-2xl text-white/50 hover:text-white cursor-pointer leading-none transition-colors;
      }
      .form-input {
        @apply w-full h-11 px-4 bg-input border border-border rounded-lg text-sm text-white placeholder-white/30 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all;
      }
      .form-label {
        @apply block mb-2 text-xs font-semibold tracking-widest uppercase text-white/80;
      }
    }
    .lucide { width: 1em; height: 1em; }
    #Msg {
        @apply fixed bottom-8 right-8 bg-green-500/90 backdrop-blur-sm text-white px-6 py-3 rounded-xl shadow-2xl z-[10001] hidden font-medium;
    }
  </style>
</head>
<body>

  <nav id="navbar" class="w-full bg-[#133785]/85 backdrop-blur-md border-b border-white/15 grid grid-cols-[auto_1fr_auto] items-center px-8 py-2.5 sticky top-0 z-[100] transition-transform duration-300">
    <a href="/home"><img src="/images/Tuners-Logo.png" alt="Tuners Logo" id="nav-logo" class="h-12 w-auto drop-shadow-md"/></a>
    <ul class="flex gap-10 justify-center">
      <li><a href="/home" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">Home</a></li>
      <li><a href="/about" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">About Us</a></li>
      <li><a href="/apply" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">Apply</a></li>
      <li><a href="#site-footer" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">Contact</a></li>
      <li><a href="/courses" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">Courses</a></li>
      <li><a href="/gallery" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors">Gallery</a></li>
      <li id="nav-dashboard" style="display:none;"><a href="#" id="nav-dashboard-link" class="font-sans text-[0.85rem] font-medium text-white/85 hover:text-white tracking-wider transition-colors text-primary font-bold">Dashboard</a></li>
    </ul>
    <div class="flex gap-4 items-center">
        <a href="/login" id="nav-login-btn" class="px-4 py-2 bg-white/10 hover:bg-white/20 hover:-translate-y-[1px] border border-white/20 rounded-lg text-[0.9rem] font-semibold transition-all">Login</a>
        <button id="nav-logout-btn" style="display:none;" onclick="globalLogout()" class="px-4 py-2 bg-white/10 hover:bg-white/20 hover:-translate-y-[1px] border border-white/20 rounded-lg text-[0.9rem] font-semibold transition-all text-destructive border-destructive/50 hover:bg-destructive/20">Logout</button>
    </div>
  </nav>

  <div class="flex-1 py-10 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-10" data-aos="fade-up">
        <h1 class="text-4xl sm:text-5xl font-bold font-display tracking-wide">Admin Dashboard</h1>
        <p class="text-white/70 mt-2">Manage Tuners operations</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-6">
        
        <!-- Room Control -->
        <div class="admin-card" data-aos="fade-up" data-aos-delay="100">
          <h2 class="card-title"><i data-lucide="door-open"></i> Room Control</h2>
          <div class="bg-black/20 p-6 rounded-xl border border-white/10 mb-6 flex items-center justify-between">
            <span class="text-white/80 font-medium">Current Status</span>
            <span id="adminRoomStatus" class="status-available">Open</span>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <button onclick="setRoomStatus('Open')" class="py-3 bg-green-500/20 hover:bg-green-500/30 text-green-400 border border-green-500/30 rounded-xl font-medium transition-colors">Set Open</button>
            <button onclick="setRoomStatus('Closed')" class="py-3 bg-red-500/20 hover:bg-red-500/30 text-red-400 border border-red-500/30 rounded-xl font-medium transition-colors">Set Closed</button>
          </div>
        </div>

        <!-- Manage Accounts -->
        <div class="admin-card" data-aos="fade-up" data-aos-delay="200">
          <h2 class="card-title"><i data-lucide="users"></i> Manage Accounts</h2>
          <div class="grid sm:grid-cols-2 gap-3 mb-4">
            <input type="text" id="new-user-name" placeholder="Full Name" class="form-input h-10">
            <input type="email" id="new-user-email" placeholder="Email Address" class="form-input h-10">
            <input type="text" id="new-user-uid" placeholder="University ID" class="form-input h-10">
            <input type="password" id="new-user-pass" placeholder="Password" class="form-input h-10">
            <select id="new-user-role" class="form-input h-10 cursor-pointer bg-[#11244e]">
              <option value="member">Member</option>
              <option value="admin">Admin</option>
            </select>
            <button onclick="addUser()" class="btn-primary h-10">Add Account</button>
          </div>
          
          <div class="overflow-x-auto border border-white/10 rounded-xl bg-black/20">
            <table class="w-full text-left text-sm" id="user-table">
              <thead class="bg-white/5 border-b border-white/10">
                <tr>
                  <th class="p-3 font-medium text-white/70">Email</th>
                  <th class="p-3 font-medium text-white/70">Role</th>
                  <th class="p-3 font-medium text-white/70 text-right">Action</th>
                </tr>
              </thead>
              <tbody id="user-list" class="divide-y divide-white/5">
                <!-- Injected via JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Manage Board Members -->
        <div class="admin-card" data-aos="fade-up" data-aos-delay="300">
          <h2 class="card-title"><i data-lucide="star"></i> Manage Board Members</h2>
          <button onclick="openAddBoardMemberModal()" class="btn-primary mb-6 flex items-center gap-2">
            <i data-lucide="plus"></i> Add Board Member
          </button>
          <div id="boardMembersList" class="space-y-3 max-h-[400px] overflow-y-auto pr-2">
            <p class="text-center text-white/60">Loading...</p>
          </div>
        </div>

        <!-- Manage Courses -->
        <div class="admin-card" data-aos="fade-up" data-aos-delay="400">
          <h2 class="card-title"><i data-lucide="book-open"></i> Manage Courses</h2>
          <button onclick="openAddCourseModal()" class="btn-primary mb-6 flex items-center gap-2">
            <i data-lucide="plus"></i> Add Course
          </button>
          <div id="coursesList" class="space-y-3 max-h-[400px] overflow-y-auto pr-2">
            <p class="text-center text-white/60">Loading...</p>
          </div>
        </div>

        <!-- Manage Gallery -->
        <div class="admin-card" data-aos="fade-up" data-aos-delay="450">
          <h2 class="card-title"><i data-lucide="image"></i> Manage Gallery</h2>
          <button onclick="openAddGalleryModal()" class="btn-primary mb-6 flex items-center gap-2">
            <i data-lucide="plus"></i> Add Image
          </button>
          <div id="galleryAdminList" class="grid grid-cols-2 gap-3 max-h-[400px] overflow-y-auto pr-2">
            <p class="text-center text-white/60 col-span-2">Loading...</p>
          </div>
        </div>

        <!-- Manage Badges -->
        <div class="admin-card" data-aos="fade-up" data-aos-delay="475">
          <h2 class="card-title"><i data-lucide="award"></i> Manage Badges</h2>
          <form id="addBadgeForm" onsubmit="createGlobalBadge(event)" class="flex gap-3 mb-6">
            <input type="text" id="new-badge-name" placeholder="e.g. 🎵 Perfect Pitch" required class="form-input flex-1 h-10">
            <button type="submit" class="btn-primary h-10 whitespace-nowrap">Add Badge</button>
          </form>
          <div id="badgesAdminList" class="space-y-2 max-h-[300px] overflow-y-auto pr-2">
            <p class="text-center text-white/60">Loading...</p>
          </div>
        </div>

        <!-- Guest Applications -->
        <div class="admin-card lg:col-span-2" data-aos="fade-up" data-aos-delay="500">
          <h2 class="card-title"><i data-lucide="file-text"></i> Guest Applications</h2>
          <div id="applications-list" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <p class="text-white/60">Loading...</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Board Member Modal -->
  <div id="boardMemberModal" class="modal-overlay">
    <div class="modal-content">
      <span onclick="closeBoardMemberModal()" class="modal-close">&times;</span>
      <h2 id="boardModalTitle" class="text-3xl font-display font-bold mb-6">Add Board Member</h2>
      <form id="boardMemberForm" onsubmit="saveBoardMember(event)" class="space-y-4">
        <input type="hidden" id="board-member-id">
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="form-label">Name *</label><input type="text" id="board-member-name" required class="form-input"></div>
          <div><label class="form-label">Position *</label><input type="text" id="board-member-position" required class="form-input"></div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="form-label">Image URL</label><input type="text" id="board-member-image" placeholder="/images/Default-pfp.png" class="form-input"></div>
          <div><label class="form-label">Or Upload File</label><input type="file" id="board-member-file" accept="image/*" class="form-input !pt-2 border-dashed"></div>
        </div>
        <div>
          <label class="form-label">Display Order</label>
          <input type="number" id="board-member-order" value="0" min="0" class="form-input">
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t border-white/10 mt-4">
          <button type="button" onclick="closeBoardMemberModal()" class="px-6 py-2 border border-white/20 rounded-lg font-medium hover:bg-white/5 transition-colors">Cancel</button>
          <button type="submit" class="btn-primary px-8">Save</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Course Modal -->
  <div id="courseModal" class="modal-overlay">
    <div class="modal-content">
      <span onclick="closeCourseModal()" class="modal-close">&times;</span>
      <h2 id="courseModalTitle" class="text-3xl font-display font-bold mb-6">Add Course</h2>
      <form id="courseForm" onsubmit="saveCourse(event)" class="space-y-4">
        <input type="hidden" id="course-id">
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="form-label">Course Title *</label><input type="text" id="course-title" required class="form-input"></div>
          <div><label class="form-label">Instructor *</label><input type="text" id="course-instructor" required class="form-input"></div>
        </div>
        <div>
          <label class="form-label">YouTube URL or ID *</label>
          <input type="text" id="course-youtube-url" required placeholder="https://youtube.com/watch?v=..." class="form-input">
        </div>
        <div><label class="form-label">Description</label><textarea id="course-description" rows="3" class="form-input h-auto py-3 resize-none"></textarea></div>
        <div class="grid sm:grid-cols-3 gap-4">
          <div>
            <label class="form-label">Category</label>
            <select id="course-category" class="form-input cursor-pointer bg-[#11244e]">
              <option value="Theory">Theory</option>
              <option value="Instrument">Instrument</option>
              <option value="Vocal">Vocal</option>
              <option value="Production">Production</option>
            </select>
          </div>
          <div><label class="form-label">Duration</label><input type="text" id="course-duration" placeholder="MM:SS or HH:MM:SS" pattern="^([0-9]{1,2}:)?[0-5][0-9]:[0-5][0-9]$" class="form-input"></div>
          <div><label class="form-label">Order</label><input type="number" id="course-order" value="0" min="0" class="form-input"></div>
        </div>
        <div class="pt-2">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="course-published" checked class="w-5 h-5 rounded border-white/20 bg-black/20 text-primary">
            <span class="text-white/90">Published (visible to students)</span>
          </label>
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t border-white/10 mt-4">
          <button type="button" onclick="closeCourseModal()" class="px-6 py-2 border border-white/20 rounded-lg font-medium hover:bg-white/5 transition-colors">Cancel</button>
          <button type="submit" class="btn-primary px-8">Save Course</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Gallery Modal -->
  <div id="galleryModal" class="modal-overlay">
    <div class="modal-content !max-w-lg">
      <span onclick="closeGalleryModal()" class="modal-close">&times;</span>
      <h2 id="galleryModalTitle" class="text-3xl font-display font-bold mb-6">Add Gallery Image</h2>
      <form id="galleryForm" onsubmit="saveGallery(event)" class="space-y-4">
        <input type="hidden" id="gallery-id">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="form-label">Image URL</label>
            <input type="text" id="gallery-image-url" placeholder="/images/your-image.jpg" class="form-input">
          </div>
          <div>
            <label class="form-label">Or Upload File</label>
            <input type="file" id="gallery-image-file" accept="image/*" class="form-input !pt-2 border-dashed">
          </div>
        </div>
        <p class="text-xs text-white/50 -mt-2">Provide either a URL or upload a file.</p>
        <div>
          <label class="form-label">Display Order</label>
          <input type="number" id="gallery-order" value="0" min="0" class="form-input">
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t border-white/10 mt-4">
          <button type="button" onclick="closeGalleryModal()" class="px-6 py-2 border border-white/20 rounded-lg font-medium hover:bg-white/5 transition-colors">Cancel</button>
          <button type="submit" class="btn-primary px-8">Save Image</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit User Modal -->
  <div id="editUserModal" class="modal-overlay">
    <div class="modal-content !max-w-lg">
      <span onclick="closeEditUserModal()" class="modal-close">&times;</span>
      <h2 class="text-3xl font-display font-bold mb-6">Edit User</h2>
      <form id="editUserForm" onsubmit="saveUserEdit(event)" class="space-y-4">
        <input type="hidden" id="edit-original-email">
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="form-label">Name</label><input type="text" id="edit-user-name" required class="form-input"></div>
          <div><label class="form-label">Email</label><input type="email" id="edit-user-email" required class="form-input"></div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="form-label">Password</label><input type="password" id="edit-user-pass" placeholder="Leave blank to keep" class="form-input"></div>
          <div>
            <label class="form-label">Role</label>
            <select id="edit-user-role" class="form-input cursor-pointer bg-[#11244e]">
              <option value="member">Member</option>
              <option value="admin">Admin</option>
            </select>
          </div>
        </div>
        <div><label class="form-label">University ID</label><input type="text" id="edit-user-uid" class="form-input"></div>
        
        <div class="pt-2">
          <label class="form-label">Badges</label>
          <div id="edit-user-badges" class="grid grid-cols-2 gap-3 mt-2">
            <!-- Dynamically populated -->
          </div>
        </div>
        
        <div class="flex justify-end gap-3 pt-4 border-t border-white/10 mt-6">
          <button type="button" onclick="closeEditUserModal()" class="px-6 py-2 border border-white/20 rounded-lg font-medium hover:bg-white/5 transition-colors">Cancel</button>
          <button type="submit" class="btn-primary px-8">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Self Modal (No Role) -->
  <div id="editSelfModal" class="modal-overlay">
    <div class="modal-content !max-w-lg">
      <span onclick="closeEditSelfModal()" class="modal-close">&times;</span>
      <h2 class="text-3xl font-display font-bold mb-6">Edit My Profile</h2>
      <form id="editSelfForm" onsubmit="saveSelfEdit(event)" class="space-y-4">
        <input type="hidden" id="edit-self-original-email">
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="form-label">Name</label><input type="text" id="edit-self-name" required class="form-input"></div>
          <div><label class="form-label">Email</label><input type="email" id="edit-self-email" required class="form-input"></div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="form-label">New Password</label><input type="password" id="edit-self-pass" placeholder="Leave blank to keep" class="form-input"></div>
          <div><label class="form-label">University ID</label><input type="text" id="edit-self-uid" class="form-input"></div>
        </div>
        <div id="edit-self-old-pass-container">
          <label class="form-label">Current Password *</label>
          <input type="password" id="edit-self-old-pass" placeholder="Required to save changes" class="form-input border-amber-500/30 focus:border-amber-500">
        </div>
        
        <div class="pt-2">
          <label class="form-label">Badges</label>
          <div id="edit-self-badges" class="grid grid-cols-2 gap-3 mt-2">
            <!-- Dynamically populated -->
          </div>
        </div>
        
        <div class="flex justify-end gap-3 pt-4 border-t border-white/10 mt-6">
          <button type="button" onclick="closeEditSelfModal()" class="px-6 py-2 border border-white/20 rounded-lg font-medium hover:bg-white/5 transition-colors">Cancel</button>
          <button type="submit" class="btn-primary px-8">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <div id="Msg"></div>

  <!-- FOOTER -->
  <footer class="w-full bg-[#0a1a3e]/65 backdrop-blur-md border-t border-white/15 py-10 mt-auto relative overflow-hidden" id="site-footer">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-[100px] bg-primary/10 blur-[80px] pointer-events-none"></div>
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 px-8 relative z-10">
      <div class="flex flex-col">
        <h3 class="text-xl font-display font-bold mb-4 tracking-wider flex items-center gap-2"><i data-lucide="music"></i> Tuners MIU</h3>
        <p class="text-white/60 text-sm mb-4 leading-relaxed">The official music club of Misr International University. Bringing harmony to campus life.</p>
        <div class="mt-auto">
          <h4 class="text-sm font-semibold mb-2 text-white/80">Contact Us</h4>
          <a href="mailto:tuners.miu.eg@gmail.com" class="inline-flex items-center gap-2 text-primary-400 hover:text-white transition-colors text-sm font-medium"><i data-lucide="mail" class="w-4 h-4"></i> tuners.miu.eg@gmail.com</a>
        </div>
      </div>
      <div>
        <h3 class="text-xl font-display font-bold mb-4 tracking-wider">Follow Us</h3>
        <ul class="space-y-3">
          <li><a href="https://www.instagram.com/tunersclubmiu" target="_blank" class="inline-flex items-center gap-2.5 px-3 py-2.5 rounded-lg bg-white/5 hover:bg-white/15 hover:text-white transition-colors text-white/80 w-full sm:w-auto"><img src="/images/Instagram.png" class="w-4 h-4 object-contain" alt="Instagram"> Instagram</a></li>
          <li><a href="https://www.facebook.com/TunersClubMIU" target="_blank" class="inline-flex items-center gap-2.5 px-3 py-2.5 rounded-lg bg-white/5 hover:bg-white/15 hover:text-white transition-colors text-white/80 w-full sm:w-auto"><img src="/images/Facebook.png" class="w-4 h-4 object-contain" alt="Facebook"> Facebook</a></li>
          <li><a href="https://www.tiktok.com/@tunersmusic" target="_blank" class="inline-flex items-center gap-2.5 px-3 py-2.5 rounded-lg bg-white/5 hover:bg-white/15 hover:text-white transition-colors text-white/80 w-full sm:w-auto"><img src="/images/Tiktok.png" class="w-4 h-4 object-contain" alt="TikTok"> TikTok</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-xl font-display font-bold mb-4 tracking-wider">Quick Links</h3>
        <div class="grid grid-cols-2 gap-2">
