<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tuners — Admin Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/Admin_Dashboard.css">
</head>
<body style="background-image: url('/images/IMG_4362.png'); background-size: cover; background-repeat: no-repeat; background-attachment: fixed;">

<nav id="navbar">
  <a href="/home"><img src="/images/Tuners-Logo.png" alt="Tuners Logo" id="nav-logo"/></a>
    <ul>
      <li><a href="/home">Home</a></li>
      <li><a href="/about">About Us</a></li>
      <li><a href="/apply">Apply</a></li>
      <li><a href="#site-footer">Contact</a></li>
      <li><a href="/courses">Courses</a></li>
      <li id="nav-dashboard" style="display:none;"><a href="#" id="nav-dashboard-link">Dashboard</a></li>
    </ul>
    <div class="nav-auth">
        <a href="/login" id="nav-login-btn">Login</a>
        <button id="nav-logout-btn" style="display:none;" onclick="globalLogout()">Logout</button>
    </div>
  </nav>

  <div class="dashboard-container">
    <h1>Admin Dashboard</h1>

    <div class="grid-layout">
      <!-- Section: Room Control -->
      <div class="admin-card room-control">
        <h2>Room Control</h2>
        <div class="status-display">
          Current Status: <span id="adminRoomStatus" class="status-available">Open</span>
        </div>
        <div class="control-buttons">
          <button onclick="setRoomStatus('Open')" class="btn-status available">Open</button>
          <button onclick="setRoomStatus('Closed')" class="btn-status occupied">Closed</button>
        </div>
      </div>

      <!-- Section: User Management -->
      <div class="admin-card user-management">
        <h2>Manage Accounts</h2>
        <div class="add-user-form">
          <input type="text" id="new-user-name" placeholder="Full Name">
          <input type="email" id="new-user-email" placeholder="Email Address">
          <input type="text" id="new-user-uid" placeholder="University ID">
          <input type="password" id="new-user-pass" placeholder="Password">
          <select id="new-user-role">
            <option value="member">Member</option>
            <option value="admin">Admin</option>
          </select>
          <button onclick="addUser()" class="btn-primary">Add Account</button>
        </div>
        <div class="user-list-container">
          <table id="user-table">
            <thead>
              <tr>
                <th>Email</th>
                <th>Role</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="user-list">
              <!-- Users will be injected here -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section: Guest Applications -->
      <div class="admin-card guest-applications">
        <h2>Guest Applications</h2>
        <div class="applications-container" id="applications-list">
          <!-- Applications will be injected here -->
          <p class="empty-msg">No applications received yet.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit User Modal -->
  <div id="editUserModal" class="modal" style="display:none;">
    <div class="modal-content">
      <span class="close" onclick="closeEditUserModal()">&times;</span>
      <h2>Edit User</h2>
      <form id="editUserForm" onsubmit="saveUserEdit(event)">
        <input type="hidden" id="edit-original-email">
        <div class="form-group">
          <label>Name</label>
          <input type="text" id="edit-user-name">
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="edit-user-email" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" id="edit-user-pass" placeholder="Leave blank to keep current password">
        </div>
        <div class="form-group">
          <label>Role</label>
          <select id="edit-user-role" style="width:100%; padding:10px; border-radius:8px; border:1px solid rgba(255,255,255,0.3); background:rgba(255,255,255,0.1); color:white;">
            <option value="member" style="color:black;">Member</option>
            <option value="admin" style="color:black;">Admin</option>
          </select>
        </div>
        <div class="form-group">
          <label>University ID</label>
          <input type="text" id="edit-user-uid">
        </div>
        <div class="form-group">
          <label>Badges</label>
          <div id="edit-user-badges" style="display: grid; grid-auto-flow: row; gap: 5px;">
            <label style="font-weight: normal; margin-bottom: 0;"><input type="checkbox" value="🎵 Perfect Pitch" style="width:auto; display:inline-block; margin-right: 8px;">🎵 Perfect Pitch</label>
            <label style="font-weight: normal; margin-bottom: 0;"><input type="checkbox" value="🎸 Guitar Hero" style="width:auto; display:inline-block; margin-right: 8px;">🎸 Guitar Hero</label>
            <label style="font-weight: normal; margin-bottom: 0;"><input type="checkbox" value="🥁 Rhythm Master" style="width:auto; display:inline-block; margin-right: 8px;">🥁 Rhythm Master</label>
            <label style="font-weight: normal; margin-bottom: 0;"><input type="checkbox" value="🎤 Vocal Virtuoso" style="width:auto; display:inline-block; margin-right: 8px;">🎤 Vocal Virtuoso</label>
            <label style="font-weight: normal; margin-bottom: 0;"><input type="checkbox" value="🎹 Keys Maestro" style="width:auto; display:inline-block; margin-right: 8px;">🎹 Keys Maestro</label>
          </div>
        </div>
        <button type="submit" class="btn-primary" style="margin-top: 10px;">Save Changes</button>
      </form>
    </div>
  </div>

  <div id="Msg"></div>

  <footer class="footer" id="site-footer">
    <div class="footer-content">
      <div class="footer-section">
        <h3>Contact Us</h3>
      </div>
      <div class="footer-section">
        <h3>Follow Us</h3>
        <ul>
          <li><a href="https://www.instagram.com/tunersclubmiu?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank">Instagram</a></li>
          <li><a href="https://www.facebook.com/TunersClubMIU" target="_blank">Facebook</a></li>
          <li><a href="https://www.tiktok.com/@tunersmusic" target="_blank">TikTok</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/home">Home</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="">Events</a></li>
          <li><a href="/courses">Courses</a></li>
          <li><a href="/apply">Apply</a></li>
          </ul>
      </div>
    </div>
  </footer>

  <script src="/js/utils.js"></script>
  <script src="/js/admin_dashboard.js"></script>
</body>
</html>
