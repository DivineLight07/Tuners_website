<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Gallery - Tuners MIU" }) %>
</head>
<body>

  <%- include("partials/navbar") %>

  <!-- CONTENT -->
  <main class="flex-1 py-16 lg:py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/10 to-transparent pointer-events-none"></div>
    <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-primary/20 rounded-full blur-[100px] pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/20 text-white text-sm font-medium mb-4 backdrop-blur-sm border border-primary/30">
          <i data-lucide="image" class="w-3.5 h-3.5"></i>
          Our Memories
        </div>
        <h1 class="text-5xl sm:text-6xl font-bold font-display tracking-wide mb-4">Gallery</h1>
        <p class="text-lg text-white/70 max-w-2xl mx-auto">Explore moments from our past events, jam sessions, and performances.</p>
        <div class="admin-only flex justify-center mt-6">
          <button onclick="openAddGalleryModal()" class="px-6 py-2 bg-primary hover:bg-[#1a48a8] text-white rounded-lg font-medium transition-colors flex items-center gap-2 mx-auto">
            <i data-lucide="plus" class="w-5 h-5"></i> Add Image
          </button>
        </div>
      </div>

      <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <!-- Gallery items will be injected here -->
      </div>
      
      <div id="loading-indicator" class="text-center py-10 text-white/60">
        <i data-lucide="loader-2" class="w-8 h-8 animate-spin mx-auto mb-2"></i>
        <p>Loading moments...</p>
      </div>
      <div id="empty-state" class="hidden text-center py-20 text-white/60">
        <i data-lucide="image" class="w-12 h-12 mx-auto mb-4 opacity-50"></i>
        <p class="text-xl">No memories added yet.</p>
      </div>
      
      <!-- Pagination Container -->
      <div id="pagination-container"></div>
    </div>
  </main>

  <%- include("partials/footer") %>
  
  <!-- Image Modal -->
  <div id="image-modal" class="fixed inset-0 bg-black/95 z-[1000] hidden items-center justify-center p-4 opacity-0 transition-opacity duration-300">
    <button onclick="closeImageModal()" class="absolute top-6 right-6 text-white/60 hover:text-white transition-colors">
        <i data-lucide="x" class="w-8 h-8"></i>
    </button>
    <img id="modal-image" src="" alt="Gallery Image" class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl border border-white/10 scale-95 transition-transform duration-300">
  </div>

  <!-- Add Gallery Modal -->
  <div id="add-gallery-modal" class="fixed inset-0 bg-black/80 z-[1000] hidden items-center justify-center p-4 backdrop-blur-sm opacity-0 transition-opacity duration-300">
    <div class="bg-[#0a1a3e] border border-white/10 rounded-2xl p-6 w-full max-w-md scale-95 transition-transform duration-300 relative shadow-2xl">
      <button onclick="closeAddGalleryModal()" class="absolute top-4 right-4 text-white/50 hover:text-white transition-colors">
          <i data-lucide="x" class="w-6 h-6"></i>
      </button>
      <h2 class="text-2xl font-display font-bold mb-6 tracking-wider">Add Gallery Image</h2>
      <form id="galleryForm" onsubmit="saveGallery(event)" class="space-y-4">
        <div>
          <label class="block text-xs uppercase tracking-widest text-white/70 mb-1">Image URL</label>
          <input type="text" id="gallery-image-url" placeholder="/images/your-image.jpg" class="w-full h-10 px-3 bg-white/5 border border-white/10 rounded-lg text-sm focus:outline-none focus:border-primary transition-colors text-white">
        </div>
        <div>
          <label class="block text-xs uppercase tracking-widest text-white/70 mb-1">Or Upload File</label>
          <input type="file" id="gallery-image-file" accept="image/*" class="w-full text-sm text-white/70 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-[#1a48a8] cursor-pointer">
        </div>
        <div>
          <label class="block text-xs uppercase tracking-widest text-white/70 mb-1">Display Order</label>
          <input type="number" id="gallery-order" value="0" min="0" class="w-full h-10 px-3 bg-white/5 border border-white/10 rounded-lg text-sm focus:outline-none focus:border-primary transition-colors text-white">
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t border-white/10 mt-6">
          <button type="button" onclick="closeAddGalleryModal()" class="px-5 py-2 border border-white/20 rounded-lg font-medium hover:bg-white/5 transition-colors text-white">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-primary text-white rounded-lg font-medium hover:bg-[#1a48a8] transition-colors">Save Image</button>
        </div>
      </form>
    </div>
  </div>

  <%- include("partials/scripts") %>
  <script>
    
    let galleryData = [];
    let currentPage = 1;
    const ITEMS_PER_PAGE = 8;
    const isAdmin = getStoredUser()?.role === 'admin';

    async function loadGallery() {
        const grid = document.getElementById('gallery-grid');
        const loader = document.getElementById('loading-indicator');
        const emptyState = document.getElementById('empty-state');
        
        try {
            const res = await fetch('/api/v1/gallery');
            const data = await res.json();
            
            loader.style.display = 'none';
            
            if (!data.data || data.data.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            }
            
            galleryData = data.data;
            renderGallery(1);
        } catch (err) {
            console.error('Error loading gallery:', err);
            loader.innerHTML = '<p class="text-destructive">Failed to load gallery.</p>';
        }
    }
    
    function renderGallery(page) {
        currentPage = page;
        const grid = document.getElementById('gallery-grid');
        
        const start = (page - 1) * ITEMS_PER_PAGE;
        const end = start + ITEMS_PER_PAGE;
        const currentItems = galleryData.slice(start, end);
        
        grid.innerHTML = currentItems.map((item, index) => {
            const delay = (index % 8) * 50;
            const adminControlsHTML = isAdmin ? `
                <div class="absolute top-3 right-3 z-20 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <button onclick="event.stopPropagation(); deleteGallery('${item._id}')" class="p-2 bg-destructive hover:bg-red-600 text-white rounded-full shadow-lg transition-transform hover:scale-110" title="Delete Image">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
            ` : '';
            return `
            <div data-aos="fade-up" data-aos-delay="${delay}" class="group relative rounded-2xl overflow-hidden cursor-pointer border border-white/10 bg-black/40 aspect-[4/3]" onclick="openImageModal('${item.imageUrl}')">
                ${adminControlsHTML}
                <img src="${item.imageUrl}" alt="Gallery Image" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                    <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center scale-75 group-hover:scale-100 transition-transform duration-300">
                        <i data-lucide="zoom-in" class="w-6 h-6 text-white"></i>
                    </div>
                </div>
            </div>
            `;
        }).join('');
        
        lucide.createIcons();
        setTimeout(() => AOS.refresh(), 100);
        
        renderPagination();
    }
    
    function renderPagination() {
        const totalPages = Math.ceil(galleryData.length / ITEMS_PER_PAGE);
        const paginationContainer = document.getElementById('pagination-container');
        
        if (totalPages <= 1) {
            paginationContainer.innerHTML = '';
            return;
        }
        
        let html = '<div class="flex justify-center items-center gap-2 mt-12">';
        
        // Prev button
        html += `<button onclick="renderGallery(${currentPage - 1})" ${currentPage === 1 ? 'disabled class="px-4 py-2 rounded-lg bg-white/5 text-white/30 cursor-not-allowed"' : 'class="px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white transition-colors"'}><i data-lucide="chevron-left" class="w-5 h-5"></i></button>`;
        
        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === currentPage) {
                html += `<button class="w-10 h-10 rounded-lg bg-primary text-white font-medium flex items-center justify-center">${i}</button>`;
            } else {
                html += `<button onclick="renderGallery(${i})" class="w-10 h-10 rounded-lg bg-white/10 hover:bg-white/20 text-white font-medium flex items-center justify-center transition-colors">${i}</button>`;
            }
        }
        
        // Next button
        html += `<button onclick="renderGallery(${currentPage + 1})" ${currentPage === totalPages ? 'disabled class="px-4 py-2 rounded-lg bg-white/5 text-white/30 cursor-not-allowed"' : 'class="px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white transition-colors"'}><i data-lucide="chevron-right" class="w-5 h-5"></i></button>`;
        
        html += '</div>';
        
        paginationContainer.innerHTML = html;
        lucide.createIcons();
    }
    
    function openImageModal(src) {
        const modal = document.getElementById('image-modal');
        const img = document.getElementById('modal-image');
        img.src = src;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        // trigger animation
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            img.classList.remove('scale-95');
        }, 10);
    }
    
    function closeImageModal() {
        const modal = document.getElementById('image-modal');
        const img = document.getElementById('modal-image');
        modal.classList.add('opacity-0');
        img.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            img.src = '';
        }, 300);
    }
    
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeImageModal();
            closeAddGalleryModal();
        }
    });
    
    function openAddGalleryModal() {
        document.getElementById('galleryForm').reset();
        const modal = document.getElementById('add-gallery-modal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modal.querySelector('div').classList.remove('scale-95');
        }, 10);
    }
    
    function closeAddGalleryModal() {
        const modal = document.getElementById('add-gallery-modal');
        modal.classList.add('opacity-0');
        modal.querySelector('div').classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }, 300);
    }

    async function saveGallery(event) {
        event.preventDefault();
        
        const formData = new FormData();
        formData.append('imageUrl', document.getElementById('gallery-image-url').value.trim());
        formData.append('order', parseInt(document.getElementById('gallery-order').value) || 0);

        const fileInput = document.getElementById('gallery-image-file');
        if (fileInput.files[0]) {
            formData.append('imageFile', fileInput.files[0]);
        }

        try {
            await apiFetch('/api/v1/gallery', { method: 'POST', body: formData });
            closeAddGalleryModal();
            const loader = document.getElementById('loading-indicator');
            const grid = document.getElementById('gallery-grid');
            grid.innerHTML = '';
            loader.style.display = 'block';
            await loadGallery();
        } catch (err) {
            alert(err.message || 'Failed to save image');
        }
    }

    async function deleteGallery(id) {
        if (!confirm('Delete this image from the gallery?')) return;

        try {
            await apiFetch(`/api/v1/gallery/${id}`, { method: 'DELETE' });

            const loader = document.getElementById('loading-indicator');
            const grid = document.getElementById('gallery-grid');
            grid.innerHTML = '';
            loader.style.display = 'block';
            await loadGallery();
        } catch (err) {
            alert(err.message || 'Failed to delete image');
        }
    }
    
    document.addEventListener('DOMContentLoaded', loadGallery);
  </script>
</body>
</html>
