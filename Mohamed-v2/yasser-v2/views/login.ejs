<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>TUNERS — Login</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

  <%- include('./partials/nav.ejs') %>

  <div class="pages-wrap">
    <div class="page active">
      <div class="card">
        <h2>Welcome Back</h2>
        <p>Sign in to your Tuners account</p>

        <% if (error) { %>
          <div class="server-err"><%= error %></div>
        <% } %>

        <form action="/auth/login" method="POST" id="loginForm" novalidate>

          <label>Email</label>
          <input type="email" name="email" id="login-email"
                 placeholder="you@miuegypt.edu.eg"
                 autocomplete="email" required/>
          <span class="err" id="login-email-err">Must be a @miuegypt.edu.eg email address.</span>

          <label>Password</label>
          <input type="password" name="password" id="login-pass"
                 placeholder="Password"
                 autocomplete="current-password" required/>
          <span class="err" id="login-pass-err">Password is required.</span>

          <button type="submit" class="btn">Login</button>
        </form>

        <div class="divider"><span>or</span></div>

        <a href="/auth/google" class="btn google-btn">
          <svg width="18" height="18" viewBox="0 0 48 48" style="margin-right:10px;flex-shrink:0">
            <path fill="#EA4335" d="M24 9.5c3.1 0 5.8 1.1 8 2.9l6-6C34.5 3.1 29.6 1 24 1 14.8 1 7 6.7 3.7 14.7l7 5.4C12.5 13.6 17.8 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.7c-.6 3-2.3 5.5-4.8 7.2l7.4 5.7c4.3-4 6.8-9.9 6.8-16.9z"/>
            <path fill="#FBBC05" d="M10.7 28.6A14.6 14.6 0 0 1 9.5 24c0-1.6.3-3.2.8-4.6l-7-5.4A23.9 23.9 0 0 0 .5 24c0 3.9.9 7.5 2.6 10.8l7.6-6.2z"/>
            <path fill="#34A853" d="M24 46.5c5.5 0 10.2-1.8 13.6-4.9l-7.4-5.7c-1.8 1.2-4.1 1.9-6.2 1.9-6.2 0-11.4-4.2-13.3-9.8l-7.6 6.2C7 42.7 14.9 46.5 24 46.5z"/>
          </svg>
          Continue with Google
        </a>

        <p class="switch-link">Not a member yet? <a href="/apply">Apply to join</a></p>

      </div>
    </div>
  </div>

  <div id="Msg"></div>
  <script src="/js/utils.js"></script>
  <script src="/js/login.js"></script>
</body>
</html>

